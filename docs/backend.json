{
  "entities": {
    "Weather": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Weather",
      "type": "object",
      "description": "Represents the weather data for a specific user's location.",
      "properties": {
        "condition": {
          "type": "string"
        },
        "forecast_daily_raw": {
          "type": "string",
          "description": "A JSON string representing the daily forecast."
        },
        "latitude": {
          "type": "number"
        },
        "location_str": {
          "type": "string"
        },
        "longitude": {
          "type": "number"
        },
        "temperature": {
          "type": "number"
        },
        "time": {
          "type": "string"
        },
        "updatedAt": {
          "type": "number"
        },
        "windspeed": {
          "type": "number"
        }
      },
      "required": [
        "condition",
        "temperature",
        "windspeed"
      ]
    },
    "Location": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Location",
      "type": "object",
      "description": "Represents a geographical location for the umbrella.",
      "properties": {
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["latitude", "longitude", "timestamp"]
    },
    "Alert": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Alert",
      "type": "object",
      "description": "Represents an alert sent by a user.",
      "properties": {
        "userId": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "message", "timestamp"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores user profile data.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "users/{userId}/weather/{weatherDocId}",
        "definition": {
          "entityName": "Weather",
          "schema": {
            "$ref": "#/backend/entities/Weather"
          },
          "description": "Stores weather data for a specific user. Typically the document ID is 'current'.",
          "params": [
            {
              "name": "userId",
              "description": "The user's ID."
            },
            {
              "name": "weatherDocId",
              "description": "The identifier for the weather document, e.g., 'current'."
            }
          ]
        }
      },
      {
        "path": "locations/{locationId}",
        "definition": {
          "entityName": "Location",
          "schema": {
            "$ref": "#/backend/entities/Location"
          },
          "description": "Stores location data for the umbrella.",
          "params": [
            {
              "name": "locationId",
              "description": "The unique identifier for the location."
            }
          ]
        }
      },
      {
        "path": "alerts",
        "definition": {
          "entityName": "Alert",
          "schema": { "$ref": "#/backend/entities/Alert" },
          "description": "Collection of all alerts sent by users."
        }
      }
    ]
  }
}
